# RAGeval Environment Configuration Example
# Copy this file to .env and configure appropriate values for your deployment environment.

# PostgreSQL Connection String (Neon Postgres database with SSL required)
POSTGRES_URL=postgresql://rageval_owner:your_password@ep-your-endpoint.neon.tech/rageval?sslmode=require

# Primary storage engine backend ('postgres' or 'sqlite')
RAGEVAL_STORE=postgres

# LLM Provider API Keys
GROQ_API_KEY=gsk_your_groq_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Comma-separated list of evaluation judge models
JUDGE_MODELS=anthropic/claude-haiku-4-5,groq/llama-3.3-70b-versatile,gemini/gemini-2.5-flash

# Embedding inference execution mode ('remote' or 'local')
INFERENCE_MODE=remote

# Embedding model identifier used for evaluation vector computations
EMBEDDING_MODEL=BAAI/bge-m3

# Endpoint URL for remote embedding inference service
EMBEDDING_ENDPOINT=https://api-inference.huggingface.co/models/BAAI/bge-m3

# Authentication token for accessing the embedding endpoint
INFERENCE_TOKEN=your_hf_or_orchestrator_token_here

# Internal authorization token for inter-service communications across OmniIntel platform
OMNIINTEL_INTERNAL_TOKEN=omniintel-prod-internal-2026

# Cross-Origin Resource Sharing (CORS) allowed origin URLs (comma-separated)
CORS_ALLOWED_ORIGINS=https://rageval-frontend.vercel.app

# Deployment runtime environment ('production' or 'development')
ENVIRONMENT=production
