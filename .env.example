# RAGeval — Drop-in LLMOps observability
RAGEVAL_STORE=sqlite
RAGEVAL_DB_PATH=~/.rageval/rageval.db
# Postgres + pgvector, production tier. When set, query embeddings are stored in a
# pgvector column (dimension: RAGEVAL_EMBEDDING_DIM below) so retrieval-relevance
# queries can use Postgres-native vector similarity instead of recomputing embeddings.
# Needs the pgvector extension (CREATE EXTENSION vector — most managed Postgres
# providers, e.g. Neon/Supabase, have it available out of the box).
# Own, dedicated var — set THIS, not a bare POSTGRES_URL. Every project in this
# portfolio has its own Postgres, and rageval no longer falls back to a generic
# POSTGRES_URL: it used to, and that fallback made rageval, when imported as a library,
# silently adopt a host app's own unrelated database (confirmed live: importing rageval
# into another project's DSPy research script wrote rageval's schema into that
# project's real production Postgres). This repo's own api.py does a narrow, one-time
# POSTGRES_URL->RAGEVAL_POSTGRES_URL compat copy at its own startup (for this project's
# existing Render deployment specifically) — that behavior is not part of the rageval
# library itself and does not apply when you `pip install` and import rageval elsewhere.
RAGEVAL_POSTGRES_URL=
RAGEVAL_EMBEDDING_DIM=1024
RAGEVAL_OTEL_ENDPOINT=

LLM_JUDGE=anthropic/claude-haiku-4-5
LLM_DEFAULT=groq/llama-3.3-70b-versatile
# Multi-judge consensus, no single-judge fallback: RAGeval needs at least 2 judges
# actually responding here (missing keys / network errors just remove that judge from
# the vote). List 2, 3, or all 4 supported providers — fewer than 2 configured, or
# fewer than 2 actually reachable at score time, raises an error (HTTP 503 from
# /eval/log|score) instead of silently scoring on 1 judge or 0.
JUDGE_MODELS=anthropic/claude-haiku-4-5,groq/llama-3.3-70b-versatile,openai/gpt-5-mini

# Embedding model (any SentenceTransformers model). Default is the English baseline.
# For non-English / multilingual corpora switch to BGE-M3 (multilingual, 100+ languages):
#   EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# Embeddings: local vs remote, provider-agnostic — pick exactly one, no hardcoded
# fallback between them (a silent swap would change retrieval-relevance numbers
# without telling you).
#   local   USE_LOCAL_EMBEDDER=true — downloads and runs EMBEDDING_MODEL directly on
#           this host (needs sentence-transformers/torch; ~400MB+ resident memory).
#   remote  INFERENCE_MODE=remote + EMBEDDING_ENDPOINT. Dispatches on the URL, not a
#           named-provider flag: a huggingface.co URL is called in HF's native
#           Inference API shape (verified live against
#           router.huggingface.co/hf-inference/models/{model}/pipeline/feature-extraction);
#           any other URL uses the generic POST {url}/embed contract
#           ({"texts":[...],"model":"..."} -> {"embeddings":[...]}) that a self-hosted
#           GPU box, an orchestrator, or anything else compliant can implement (verified
#           live against a real on-demand inference host). INFERENCE_TOKEN is the
#           bearer token either way.
# Neither set -> embeddings degrade to a stdlib lexical-overlap score (no network
# call, no torch) so scoring still returns a real number instead of silently 0.0.
USE_LOCAL_EMBEDDER=false
INFERENCE_MODE=
EMBEDDING_ENDPOINT=
INFERENCE_TOKEN=

GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

LOG_LEVEL=INFO

# CORS: comma-separated allowed origins for the API. Empty = "*" (dev). Set in production.
# The single-container self-hosting story (frontend served from the same origin as the
# API, see api.py's SPA mount) means this is mainly a local-dev concern — the frontend
# dev server's own origin, not another project's.
CORS_ALLOWED_ORIGINS=http://localhost:5176,http://localhost:3000
# disable, or override the destination here.

# E2E test admin login password, must match the deployed admin account
ADMIN_PASS=
# Shared secret for internal service-to-service auth, must match the value configured on the gateway and all other OmniIntel services
OMNIINTEL_INTERNAL_TOKEN=

# When true (default), /eval/log|metrics|queries|cost-report|alerts scope each visitor to
# their own logged queries (via a browser-generated X-Demo-Session-Id header) plus any
# session-less platform telemetry (e.g. IntelAI's own dogfooding calls). Anonymous demo
# isolation, not production auth — a real multi-user deployment should add its own auth.
DEMO_SESSION_SCOPING=true
