# RAGeval configuration. Copy to `.env` and fill in what you use. Every value is read from the
# environment; nothing is hardcoded. Empty means "unset". Never commit a filled-in copy.

# ─── Server ──────────────────────────────────────────────────────────────────
# TCP port the API listens on (the container image reads this too). Default 8003.
PORT=8003
# Python log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# Python logging format string. Default is a timestamped single-line format.
# LOG_FORMAT=
# Directory for local state (SQLite file, telemetry install id). Default ~/.rageval.
# RAGEVAL_HOME=
# Comma-separated browser origins allowed to call the API. Empty or "*" allows any origin
# (development only); set explicit origins in production.
CORS_ALLOWED_ORIGINS=http://localhost:5176,http://localhost:3000

# ─── Access control ──────────────────────────────────────────────────────────
# When true, every API route except health, readiness, docs and static assets requires
# one of the tokens below in the X-RAGeval-Internal-Token (or Bearer) header.
REQUIRE_INTERNAL_TOKEN=false
# Shared secret(s) accepted when REQUIRE_INTERNAL_TOKEN=true. Any one of the three is enough;
# the alternates exist so one token can be shared across several services.
RAGEVAL_INTERNAL_TOKEN=
INTERNAL_TOKEN=
OMNIINTEL_INTERNAL_TOKEN=
# Secret presented in the X-Admin-Token header to read across every visitor session.
ADMIN_TOKEN=
# When true (default), reads are limited to the visitor's own records, identified by the
# X-Demo-Session-Id header. This is anonymous isolation, not user authentication.
DEMO_SESSION_SCOPING=true

# ─── Storage ─────────────────────────────────────────────────────────────────
# sqlite (default, zero setup) or postgres (set RAGEVAL_POSTGRES_URL).
RAGEVAL_STORE=sqlite
# SQLite file path. Default <RAGEVAL_HOME>/rageval.db.
RAGEVAL_DB_PATH=
# Postgres connection URL for the production tier (needs the pgvector extension). Use this
# dedicated variable so that importing the library never writes into a host app's database.
# The standalone API also accepts a bare POSTGRES_URL and copies it here at startup.
RAGEVAL_POSTGRES_URL=
# POSTGRES_URL=
# Width of the pgvector column. Must equal the output dimension of EMBEDDING_MODEL (1024 for
# BGE-M3). Changing it requires a new column.
RAGEVAL_EMBEDDING_DIM=1024
# OTLP endpoint for OpenTelemetry span export. Empty disables the exporter.
RAGEVAL_OTEL_ENDPOINT=

# ─── Judge panel ─────────────────────────────────────────────────────────────
# Comma-separated provider/model identifiers forming the groundedness panel. At least two
# must be configured and reachable at scoring time, otherwise scoring returns HTTP 503.
JUDGE_MODELS=anthropic/claude-haiku-4-5,groq/openai/gpt-oss-120b,gemini/gemini-flash-latest,openai/gpt-4o-mini
# Primary single-judge model name (used by library helpers and reported in /eval/config).
LLM_JUDGE=anthropic/claude-haiku-4-5
# Model used for the default analyst role in library helpers.
LLM_DEFAULT=groq/openai/gpt-oss-120b
# Optional model tried for a judge whose primary call fails (credentials, outage).
LLM_JUDGE_FALLBACK=
# Seconds to wait for one judge call (default 90, maximum 300).
JUDGE_TIMEOUT=90
# Seconds to wait for one remote embedding call (default 30, maximum 120).
EMBED_TIMEOUT=30
# How judge scores are combined: weighted_mean (default) or geometric_median (weighted median
# for scalar scores; more robust when judges make correlated errors). Changing it changes
# every consensus score, so it is opt-in.
RAGEVAL_AGGREGATION_STRATEGY=weighted_mean
# Adds a no-cost, non-LLM verification signal (numeric-fact consistency and lexical overlap
# with the retrieved context) to the panel. Default false.
RAGEVAL_INCLUDE_SYMBOLIC_JUDGE=false

# ─── Provider keys ───────────────────────────────────────────────────────────
# Only providers named in JUDGE_MODELS need a key. A comma- or whitespace-separated
# <PROVIDER>_API_KEYS list, or extra <PROVIDER>_API_KEY_<suffix> variables, are rotated
# round-robin; a rate-limited key is skipped until its retry window ends.
# <PROVIDER>_KEY_SLOTS (for example "1,3") pins this deployment to a subset of those keys.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
# GROQ_API_KEYS=
# GROQ_KEY_SLOTS=

# ─── Embeddings (choose exactly one mode) ────────────────────────────────────
# Model identifier for retrieval relevance and faithfulness similarity. Any
# sentence-transformers model; BGE-M3 is multilingual (100+ languages).
EMBEDDING_MODEL=BAAI/bge-m3
# Mode 1, local: load EMBEDDING_MODEL in this process (needs sentence-transformers/torch).
USE_LOCAL_EMBEDDER=false
# Mode 2, remote: set INFERENCE_MODE=remote plus an endpoint. A huggingface.co URL is called in
# the native feature-extraction shape; any other URL receives POST {url}/embed with
# {"texts": [...], "model": "..."} and must answer {"embeddings": [[...], ...]}.
INFERENCE_MODE=
EMBEDDING_ENDPOINT=
# Bearer token sent to the embedding endpoint.
INFERENCE_TOKEN=
# Neither mode set: similarity falls back to a lexical-overlap score (no network, no torch).

# ─── Request limits ──────────────────────────────────────────────────────────
# Maximum accepted request body in bytes (default 1 MiB).
RAGEVAL_MAX_REQUEST_BODY_BYTES=1048576
# Evaluations allowed to run at once; further requests wait their turn (default 2).
RAGEVAL_MAX_CONCURRENT_EVALUATIONS=2

# ─── Telemetry ───────────────────────────────────────────────────────────────
# One anonymous startup ping (service name, version, random install id; no prompts, answers,
# scores or keys). Disable with TELEMETRY_OPT_OUT=true or DO_NOT_TRACK=1.
TELEMETRY_OPT_OUT=false
DO_NOT_TRACK=
# Override the ping destination. Empty uses the project default.
TELEMETRY_URL=

# ─── Frontend build (Vite) ───────────────────────────────────────────────────
# Base URL of the API when the dashboard is hosted separately. Empty = same origin.
VITE_API_BASE_URL=
# Dev server proxy target for /api calls during `npm run dev`.
VITE_PROXY_TARGET=http://localhost:8003
